<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="1150.0" prefHeight="700.0"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.dealerlink.controller.DealerDashboardController">

    <!-- Left Navigation Sidebar -->
    <left>
        <VBox spacing="16.0" prefWidth="240.0" styleClass="sidebar">
            <padding>
                <Insets top="20" right="16" bottom="20" left="16"/>
            </padding>

            <!-- Brand Header -->
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label text="DealerLink" styleClass="brand-label"/>
                <Label text="DEALER" styleClass="brand-tag"/>
            </HBox>

            <Separator opacity="0.15"/>

            <!-- Current User Profile Chip -->
            <VBox spacing="4.0" styleClass="user-badge">
                <Label fx:id="headerLabel" text="Dealer Portal" styleClass="user-name"/>
                <Label text="Warehouse &amp; Supply Hub" styleClass="user-city"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Actions -->
            <VBox spacing="8.0">
                <Button text="Refresh Workspace" onAction="#handleRefresh" maxWidth="Infinity"/>
                <Button text="Sign Out" onAction="#handleLogout" maxWidth="Infinity" styleClass="danger-button"/>
            </VBox>
        </VBox>
    </left>

    <!-- Main Content Area -->
    <center>
        <VBox spacing="16.0" style="-fx-background-color: #f8fafc;">
            <!-- Top App Bar -->
            <HBox alignment="CENTER_LEFT" styleClass="top-header">
                <VBox spacing="2">
                    <Label text="Dealer Distribution Center" styleClass="header-title"/>
                    <Label text="Stock control, request quotation bids, and dispatch tracker." style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="weatherStatusLabel" text="Checking weather..." styleClass="weather-badge"/>
            </HBox>

            <!-- Tab Workspaces -->
            <VBox spacing="12.0" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="0" right="20" bottom="18" left="20"/>
                </padding>

                <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                    <!-- Tab 1: Inventory -->
                    <Tab text="Inventory Management">
                        <VBox spacing="14.0">
                            <padding>
                                <Insets top="16" right="0" bottom="0" left="0"/>
                            </padding>

                            <!-- Stock Upsert Form -->
                            <VBox spacing="10.0" styleClass="panel-card">
                                <Label text="Add or Update Warehouse SKU" styleClass="panel-title"/>
                                <HBox spacing="12.0" alignment="CENTER_LEFT">
                                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                                        <Label text="Product Name" styleClass="form-label"/>
                                        <TextField fx:id="invProductNameField" promptText="e.g. Steel Rods"/>
                                    </VBox>
                                    <VBox spacing="3" prefWidth="100.0">
                                        <Label text="Unit" styleClass="form-label"/>
                                        <TextField fx:id="invUnitField" promptText="e.g. metric ton"/>
                                    </VBox>
                                    <VBox spacing="3" prefWidth="100.0">
                                        <Label text="Stock Available" styleClass="form-label"/>
                                        <TextField fx:id="invQtyField" promptText="Units"/>
                                    </VBox>
                                    <VBox spacing="3" prefWidth="110.0">
                                        <Label text="Unit Price ($)" styleClass="form-label"/>
                                        <TextField fx:id="invPriceField" promptText="0.00"/>
                                    </VBox>
                                    <VBox alignment="BOTTOM_LEFT">
                                        <Button text="Save / Update Stock" onAction="#handleUpsertInventory" styleClass="primary-button" minWidth="-Infinity"/>
                                    </VBox>
                                </HBox>
                                <Label fx:id="invFeedbackLabel" styleClass="status-label"/>
                            </VBox>

                            <TableView fx:id="inventoryTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colInvId" text="SKU ID" prefWidth="70.0"/>
                                    <TableColumn fx:id="colInvProduct" text="Product Name" prefWidth="240.0"/>
                                    <TableColumn fx:id="colInvUnit" text="Unit" prefWidth="100.0"/>
                                    <TableColumn fx:id="colInvQty" text="Available Stock" prefWidth="140.0"/>
                                    <TableColumn fx:id="colInvPrice" text="Unit Price ($)" prefWidth="130.0"/>
                                    <TableColumn fx:id="colInvUpdated" text="Timestamp" prefWidth="190.0"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </Tab>

                    <!-- Tab 2: Incoming Requests -->
                    <Tab text="Open Market Requests">
                        <VBox spacing="14.0">
                            <padding>
                                <Insets top="16" right="0" bottom="0" left="0"/>
                            </padding>
                            <TableView fx:id="requestsTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colReqId" text="Req #" prefWidth="70.0"/>
                                    <TableColumn fx:id="colReqShop" text="Shop Name" prefWidth="160.0"/>
                                    <TableColumn fx:id="colReqCity" text="Shop City" prefWidth="110.0"/>
                                    <TableColumn fx:id="colReqProduct" text="Requested Product" prefWidth="180.0"/>
                                    <TableColumn fx:id="colReqUnit" text="Unit" prefWidth="85.0"/>
                                    <TableColumn fx:id="colReqQty" text="Quantity" prefWidth="90.0"/>
                                    <TableColumn fx:id="colReqNotes" text="Notes" prefWidth="160.0"/>
                                    <TableColumn fx:id="colReqStatus" text="Status" prefWidth="100.0"/>
                                </columns>
                            </TableView>

                            <!-- Submit Bid Form -->
                            <VBox spacing="10.0" styleClass="panel-card">
                                <Label text="Submit Formal Quotation for Selected Request" styleClass="panel-title"/>
                                <HBox spacing="12.0" alignment="CENTER_LEFT">
                                    <VBox spacing="3" prefWidth="120.0">
                                        <Label text="Price / Unit ($)" styleClass="form-label"/>
                                        <TextField fx:id="quoteUnitRateField" promptText="0.00"/>
                                    </VBox>
                                    <VBox spacing="3" prefWidth="100.0">
                                        <Label text="Lead Time (Days)" styleClass="form-label"/>
                                        <TextField fx:id="quoteDaysField" promptText="e.g. 3"/>
                                    </VBox>
                                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                                        <Label text="Message to Shop" styleClass="form-label"/>
                                        <TextArea fx:id="quoteMsgArea" promptText="Availability, transport notes..." prefRowCount="1"/>
                                    </VBox>
                                    <VBox alignment="BOTTOM_LEFT">
                                        <Button text="Send Quotation" onAction="#handleSubmitQuotation" styleClass="success-button" minWidth="-Infinity"/>
                                    </VBox>
                                </HBox>
                                <Label fx:id="quoteFeedbackLabel" styleClass="status-label"/>
                            </VBox>
                        </VBox>
                    </Tab>

                    <!-- Tab 3: Dispatch & Logistics -->
                    <Tab text="Orders &amp; Dispatch Logistics">
                        <VBox spacing="14.0">
                            <padding>
                                <Insets top="16" right="0" bottom="0" left="0"/>
                            </padding>
                            <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colOrderId" text="Order #" prefWidth="75.0"/>
                                    <TableColumn fx:id="colOrderShop" text="Shop Buyer" prefWidth="150.0"/>
                                    <TableColumn fx:id="colOrderProduct" text="Product" prefWidth="160.0"/>
                                    <TableColumn fx:id="colOrderUnit" text="Unit" prefWidth="80.0"/>
                                    <TableColumn fx:id="colOrderTotal" text="Total ($)" prefWidth="110.0"/>
                                    <TableColumn fx:id="colOrderStatus" text="Order Status" prefWidth="120.0"/>
                                    <TableColumn fx:id="colOrderDeliveryStatus" text="Dispatch Status" prefWidth="130.0"/>
                                    <TableColumn fx:id="colOrderLocation" text="Transit Checkpoint" prefWidth="140.0"/>
                                    <TableColumn fx:id="colOrderWeather" text="Route Weather" prefWidth="160.0"/>
                                </columns>
                            </TableView>

                            <!-- Shipment Tracker Form -->
                            <VBox spacing="10.0" styleClass="panel-card">
                                <Label text="Update Dispatch Tracking &amp; Route Logistics" styleClass="panel-title"/>
                                <HBox spacing="12.0" alignment="CENTER_LEFT">
                                    <VBox spacing="3" prefWidth="140.0">
                                        <Label text="Status" styleClass="form-label"/>
                                        <ComboBox fx:id="deliveryStatusComboBox" maxWidth="Infinity"/>
                                    </VBox>
                                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                                        <Label text="Current Transit Location" styleClass="form-label"/>
                                        <TextField fx:id="deliveryLocationField" promptText="Checkpoint city (e.g. Jessore)"/>
                                    </VBox>
                                    <VBox spacing="3" prefWidth="130.0">
                                        <Label text="Estimated Arrival" styleClass="form-label"/>
                                        <TextField fx:id="deliveryEtaField" promptText="e.g. 24 Hours"/>
                                    </VBox>
                                    <VBox alignment="BOTTOM_LEFT">
                                        <Button text="Update Transit Log" onAction="#handleUpdateDelivery" styleClass="primary-button" minWidth="-Infinity"/>
                                    </VBox>
                                </HBox>
                                <Label fx:id="orderFeedbackLabel" styleClass="status-label"/>
                            </VBox>
                        </VBox>
                    </Tab>
                </TabPane>
            </VBox>
        </VBox>
    </center>
</BorderPane>