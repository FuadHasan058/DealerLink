<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="1150.0" prefHeight="700.0"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.dealerlink.controller.ShopDashboardController">

    <!-- Left Navigation Sidebar -->
    <left>
        <VBox spacing="16.0" prefWidth="240.0" styleClass="sidebar">
            <padding>
                <Insets top="20" right="16" bottom="20" left="16"/>
            </padding>

            <!-- Brand Section -->
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label text="DealerLink" styleClass="brand-label"/>
                <Label text="SHOP" styleClass="brand-tag"/>
            </HBox>

            <Separator opacity="0.15"/>

            <!-- Current User Profile Chip -->
            <VBox spacing="4.0" styleClass="user-badge">
                <Label fx:id="headerLabel" text="Shop Owner" styleClass="user-name"/>
                <Label text="Verified Commercial Account" styleClass="user-city"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Sidebar Actions -->
            <VBox spacing="8.0">
                <Button text="Refresh Dashboard" onAction="#handleRefresh" maxWidth="Infinity"/>
                <Button text="Sign Out" onAction="#handleLogout" maxWidth="Infinity" styleClass="danger-button"/>
            </VBox>
        </VBox>
    </left>

    <!-- Main Content Workspace -->
    <center>
        <VBox spacing="16.0" style="-fx-background-color: #f8fafc;">
            <!-- Top App Bar -->
            <HBox alignment="CENTER_LEFT" styleClass="top-header">
                <VBox spacing="2">
                    <Label text="Procurement &amp; Supply Orders" styleClass="header-title"/>
                    <Label text="Create requests, review live dealer bids, and monitor dispatch." style="-fx-text-fill: #64748b; -fx-font-size: 12px;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="weatherStatusLabel" text="Checking weather..." styleClass="weather-badge"/>
            </HBox>

            <!-- Content Area with Tabs -->
            <VBox spacing="12.0" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets top="0" right="20" bottom="18" left="20"/>
                </padding>

                <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                    <!-- Tab 1: Requests -->
                    <Tab text="Product Requests">
                        <VBox spacing="14.0">
                            <padding>
                                <Insets top="16" right="0" bottom="0" left="0"/>
                            </padding>

                            <!-- Modernized Request Form -->
                            <VBox spacing="10.0" styleClass="panel-card">
                                <Label text="Create New Supply Request" styleClass="panel-title"/>
                                <HBox spacing="12.0" alignment="CENTER_LEFT">
                                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                                        <Label text="Product Name" styleClass="form-label"/>
                                        <TextField fx:id="productNameField" promptText="e.g. Portland Cement"/>
                                    </VBox>
                                    <VBox spacing="3" prefWidth="100.0">
                                        <Label text="Unit" styleClass="form-label"/>
                                        <TextField fx:id="unitField" promptText="e.g. bag, kg"/>
                                    </VBox>
                                    <VBox spacing="3" prefWidth="90.0">
                                        <Label text="Quantity" styleClass="form-label"/>
                                        <TextField fx:id="quantityField" promptText="Qty"/>
                                    </VBox>
                                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                                        <Label text="Notes / Requirements" styleClass="form-label"/>
                                        <TextArea fx:id="notesArea" promptText="Delivery instructions..." prefRowCount="1"/>
                                    </VBox>
                                    <VBox alignment="BOTTOM_LEFT">
                                        <Button text="Broadcast Request" onAction="#handleCreateRequest" styleClass="primary-button" minWidth="-Infinity"/>
                                    </VBox>
                                </HBox>
                                <Label fx:id="requestFeedbackLabel" styleClass="status-label"/>
                            </VBox>

                            <Label text="My Active Requests (Select a row to inspect incoming dealer quotations):" style="-fx-font-weight: 700; -fx-text-fill: #334155; -fx-font-size: 12px;"/>
                            <TableView fx:id="myRequestsTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colReqId" text="ID" prefWidth="60.0"/>
                                    <TableColumn fx:id="colReqProduct" text="Product" prefWidth="220.0"/>
                                    <TableColumn fx:id="colReqUnit" text="Unit" prefWidth="90.0"/>
                                    <TableColumn fx:id="colReqQty" text="Quantity" prefWidth="100.0"/>
                                    <TableColumn fx:id="colReqStatus" text="Status" prefWidth="120.0"/>
                                    <TableColumn fx:id="colReqDate" text="Date Submitted" prefWidth="200.0"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </Tab>

                    <!-- Tab 2: Dealer Quotations -->
                    <Tab text="Dealer Quotations">
                        <VBox spacing="14.0">
                            <padding>
                                <Insets top="16" right="0" bottom="0" left="0"/>
                            </padding>
                            <Label text="Live Quotations for Selected Request" styleClass="panel-title"/>
                            <TableView fx:id="quotationsTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colQuoteId" text="Quote ID" prefWidth="75.0"/>
                                    <TableColumn fx:id="colQuoteDealer" text="Dealer Name" prefWidth="160.0"/>
                                    <TableColumn fx:id="colQuoteCity" text="Hub City" prefWidth="110.0"/>
                                    <TableColumn fx:id="colQuotePriceUnit" text="Rate / Unit" prefWidth="110.0"/>
                                    <TableColumn fx:id="colQuoteTotal" text="Total Price ($)" prefWidth="130.0"/>
                                    <TableColumn fx:id="colQuoteDays" text="Lead Time (Days)" prefWidth="130.0"/>
                                    <TableColumn fx:id="colQuoteWeather" text="Route Weather Assessment" prefWidth="200.0"/>
                                    <TableColumn fx:id="colQuoteStatus" text="Status" prefWidth="110.0"/>
                                </columns>
                            </TableView>
                            <HBox spacing="12.0" alignment="CENTER_LEFT">
                                <Button text="Accept Quotation &amp; Issue Order" onAction="#handleAcceptQuotation" styleClass="success-button"/>
                                <Label fx:id="quoteFeedbackLabel" styleClass="status-label"/>
                            </HBox>
                        </VBox>
                    </Tab>

                    <!-- Tab 3: Order History -->
                    <Tab text="Orders &amp; Deliveries">
                        <VBox spacing="14.0">
                            <padding>
                                <Insets top="16" right="0" bottom="0" left="0"/>
                            </padding>
                            <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colOrderId" text="Order #" prefWidth="80.0"/>
                                    <TableColumn fx:id="colOrderProduct" text="Product" prefWidth="160.0"/>
                                    <TableColumn fx:id="colOrderUnit" text="Unit" prefWidth="80.0"/>
                                    <TableColumn fx:id="colOrderDealer" text="Dealer" prefWidth="140.0"/>
                                    <TableColumn fx:id="colOrderTotal" text="Amount ($)" prefWidth="110.0"/>
                                    <TableColumn fx:id="colOrderStatus" text="Order Status" prefWidth="120.0"/>
                                    <TableColumn fx:id="colOrderDeliveryStatus" text="Shipment Status" prefWidth="130.0"/>
                                    <TableColumn fx:id="colOrderLocation" text="Transit Location" prefWidth="140.0"/>
                                    <TableColumn fx:id="colOrderWeather" text="Transit Conditions" prefWidth="160.0"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </Tab>
                </TabPane>
            </VBox>
        </VBox>
    </center>
</BorderPane>