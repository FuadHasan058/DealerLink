<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="1000.0" prefHeight="650.0"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.dealerlink.controller.ShopDashboardController">

    <!-- Top Navigation Bar -->
    <top>
        <HBox spacing="15.0" alignment="CENTER_LEFT" styleClass="top-nav">
            <padding>
                <Insets top="12" right="20" bottom="12" left="20"/>
            </padding>
            <Label fx:id="headerLabel" text="Shop Owner Dashboard" styleClass="nav-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="weatherStatusLabel" text="Weather: Loading..." styleClass="weather-tag"/>
            <Button text="Refresh" onAction="#handleRefresh"/>
            <Button text="Sign Out" onAction="#handleLogout" styleClass="danger-button"/>
        </HBox>
    </top>

    <!-- Main Content Area -->
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <!-- Tab 1: Submit & View Requests -->
            <Tab text="Product Requests">
                <VBox spacing="12.0">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15"/>
                    </padding>

                    <!-- TextFields for Free-Text Product Entry -->
                    <HBox spacing="10.0" alignment="CENTER_LEFT" styleClass="card-pane">
                        <padding>
                            <Insets top="10" right="10" bottom="10" left="10"/>
                        </padding>
                        <Label text="Product:"/>
                        <TextField fx:id="productNameField" promptText="Enter product name" prefWidth="180.0"/>
                        <Label text="Unit:"/>
                        <TextField fx:id="unitField" promptText="e.g. kg, bag" prefWidth="80.0"/>
                        <Label text="Qty:"/>
                        <TextField fx:id="quantityField" promptText="Quantity" prefWidth="75.0"/>
                        <Label text="Notes:"/>
                        <TextArea fx:id="notesArea" promptText="Optional notes" prefRowCount="1" prefWidth="170.0"/>
                        <Button text="Send Request" onAction="#handleCreateRequest" styleClass="primary-button"/>
                        <Label fx:id="requestFeedbackLabel" styleClass="status-label"/>
                    </HBox>

                    <Label text="My Submitted Requests (Click row to view quotes below):" style="-fx-font-weight: bold;"/>
                    <TableView fx:id="myRequestsTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colReqId" text="ID" prefWidth="50.0"/>
                            <TableColumn fx:id="colReqProduct" text="Product" prefWidth="180.0"/>
                            <TableColumn fx:id="colReqQty" text="Quantity" prefWidth="90.0"/>
                            <TableColumn fx:id="colReqStatus" text="Status" prefWidth="120.0"/>
                            <TableColumn fx:id="colReqDate" text="Date Submitted" prefWidth="200.0"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>

            <!-- Tab 2: Compare Quotations -->
            <Tab text="Dealer Quotations">
                <VBox spacing="12.0">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15"/>
                    </padding>
                    <Label text="Quotes Received for Selected Request:" style="-fx-font-weight: bold;"/>
                    <TableView fx:id="quotationsTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colQuoteId" text="Quote ID" prefWidth="65.0"/>
                            <TableColumn fx:id="colQuoteDealer" text="Dealer" prefWidth="140.0"/>
                            <TableColumn fx:id="colQuoteCity" text="City" prefWidth="100.0"/>
                            <TableColumn fx:id="colQuotePriceUnit" text="Unit Price ($)" prefWidth="100.0"/>
                            <TableColumn fx:id="colQuoteTotal" text="Total Amount ($)" prefWidth="120.0"/>
                            <TableColumn fx:id="colQuoteDays" text="Lead Time (Days)" prefWidth="110.0"/>
                            <TableColumn fx:id="colQuoteWeather" text="Dealer Route Weather" prefWidth="180.0"/>
                            <TableColumn fx:id="colQuoteStatus" text="Status" prefWidth="100.0"/>
                        </columns>
                    </TableView>
                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                        <Button text="Accept Quotation &amp; Place Order" onAction="#handleAcceptQuotation" styleClass="success-button"/>
                        <Label fx:id="quoteFeedbackLabel" styleClass="status-label"/>
                    </HBox>
                </VBox>
            </Tab>

            <!-- Tab 3: Order History & Tracking -->
            <Tab text="Orders &amp; Shipments">
                <VBox spacing="12.0">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15"/>
                    </padding>
                    <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colOrderId" text="Order ID" prefWidth="70.0"/>
                            <TableColumn fx:id="colOrderProduct" text="Product" prefWidth="150.0"/>
                            <TableColumn fx:id="colOrderDealer" text="Dealer" prefWidth="140.0"/>
                            <TableColumn fx:id="colOrderTotal" text="Total ($)" prefWidth="110.0"/>
                            <TableColumn fx:id="colOrderStatus" text="Order Status" prefWidth="110.0"/>
                            <TableColumn fx:id="colOrderDeliveryStatus" text="Shipment Status" prefWidth="120.0"/>
                            <TableColumn fx:id="colOrderLocation" text="Current Location" prefWidth="130.0"/>
                            <TableColumn fx:id="colOrderWeather" text="Transit Weather" prefWidth="150.0"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
        </TabPane>
    </center>
</BorderPane>