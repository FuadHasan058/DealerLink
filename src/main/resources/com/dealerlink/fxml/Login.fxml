<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="20.0" prefWidth="1000.0" prefHeight="650.0"
      styleClass="root-pane"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.dealerlink.controller.LoginController">

    <padding>
        <Insets top="25" right="40" bottom="25" left="40"/>
    </padding>

    <!-- Top Logo & Header -->
    <VBox alignment="CENTER" spacing="8.0">
        <HBox alignment="CENTER" spacing="12.0">
            <StackPane styleClass="brand-icon-box-large">
                <Region styleClass="brand-icon-shape-large"/>
            </StackPane>
            <VBox alignment="CENTER_LEFT" spacing="0">
                <Label text="DealerLink" styleClass="app-title-light"/>
                <Label text="Smart B2B Supply &amp; Distribution Platform" styleClass="app-subtitle-light"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- Login/Register Card -->
    <TabPane tabClosingPolicy="UNAVAILABLE" maxWidth="480.0" styleClass="login-card">
        <!-- Sign In -->
        <Tab text="Sign In">
            <VBox spacing="14.0">
                <padding>
                    <Insets top="22" right="25" bottom="22" left="25"/>
                </padding>

                <Label text="Portal Type:" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="loginRoleComboBox" maxWidth="Infinity"/>

                <Label text="Username:" style="-fx-font-weight: bold;"/>
                <TextField fx:id="loginUsernameField" promptText="Enter your registered username"/>

                <Label text="Password:" style="-fx-font-weight: bold;"/>
                <PasswordField fx:id="loginPasswordField" promptText="Enter your account password"/>

                <Button text="Sign In to Platform" onAction="#handleLogin" maxWidth="Infinity" styleClass="primary-button"/>
                <Label fx:id="loginStatusLabel" styleClass="error-label"/>
            </VBox>
        </Tab>

        <!-- Register -->
        <Tab text="Create New Account">
            <VBox spacing="10.0">
                <padding>
                    <Insets top="20" right="25" bottom="20" left="25"/>
                </padding>

                <HBox spacing="10">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Role:" style="-fx-font-weight: bold;"/>
                        <ComboBox fx:id="regRoleComboBox" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Username:" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="regUsernameField" promptText="Choose username"/>
                    </VBox>
                </HBox>

                <Label text="Password:" style="-fx-font-weight: bold;"/>
                <PasswordField fx:id="regPasswordField" promptText="Create secure password"/>

                <Label text="Full / Business Name:" style="-fx-font-weight: bold;"/>
                <TextField fx:id="regNameField" promptText="Company or Owner Name"/>

                <HBox spacing="10">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="City:" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="regCityField" promptText="City name (e.g. Khulna)"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Phone:" style="-fx-font-weight: bold;"/>
                        <TextField fx:id="regPhoneField" promptText="Contact number"/>
                    </VBox>
                </HBox>

                <Label text="Address:" style="-fx-font-weight: bold;"/>
                <TextField fx:id="regAddressField" promptText="Physical store or office address"/>

                <Button text="Complete Registration" onAction="#handleRegister" maxWidth="Infinity" styleClass="success-button"/>
                <Label fx:id="regStatusLabel" styleClass="error-label"/>
            </VBox>
        </Tab>
    </TabPane>
</VBox>