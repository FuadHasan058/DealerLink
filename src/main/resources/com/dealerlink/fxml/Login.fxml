<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="22.0" prefWidth="1050.0" prefHeight="680.0"
      styleClass="login-bg"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.dealerlink.controller.LoginController">

    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <!-- Header Branding -->
    <VBox alignment="CENTER" spacing="6.0">
        <HBox alignment="CENTER" spacing="10">
            <Label text="DealerLink" style="-fx-font-size: 32px; -fx-font-weight: 800; -fx-text-fill: #ffffff; -fx-letter-spacing: -0.5px;"/>
            <Label text="B2B" styleClass="brand-tag"/>
        </HBox>
        <Label text="Connected Commerce &amp; Supply Chain Logistics" style="-fx-text-fill: #94a3b8; -fx-font-size: 13px;"/>
    </VBox>

    <!-- Glass Form Card -->
    <TabPane tabClosingPolicy="UNAVAILABLE" maxWidth="440.0" styleClass="login-card">
        <!-- Sign In -->
        <Tab text="Account Sign In">
            <VBox spacing="14.0">
                <padding>
                    <Insets top="24" right="28" bottom="24" left="28"/>
                </padding>

                <VBox spacing="4">
                    <Label text="Sign in As" styleClass="form-label"/>
                    <ComboBox fx:id="loginRoleComboBox" maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Username" styleClass="form-label"/>
                    <TextField fx:id="loginUsernameField" promptText="Enter username"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Password" styleClass="form-label"/>
                    <PasswordField fx:id="loginPasswordField" promptText="Enter password"/>
                </VBox>

                <Button text="Sign In to Dashboard" onAction="#handleLogin" maxWidth="Infinity" styleClass="primary-button"/>
                <Label fx:id="loginStatusLabel" styleClass="error-label"/>
            </VBox>
        </Tab>

        <!-- Register -->
        <Tab text="Create Account">
            <VBox spacing="10.0">
                <padding>
                    <Insets top="20" right="28" bottom="20" left="28"/>
                </padding>

                <HBox spacing="10">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Role" styleClass="form-label"/>
                        <ComboBox fx:id="regRoleComboBox" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Username" styleClass="form-label"/>
                        <TextField fx:id="regUsernameField" promptText="Username"/>
                    </VBox>
                </HBox>

                <VBox spacing="4">
                    <Label text="Password" styleClass="form-label"/>
                    <PasswordField fx:id="regPasswordField" promptText="Create password"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Company or Full Name" styleClass="form-label"/>
                    <TextField fx:id="regNameField" promptText="e.g. Apex Hardware Store"/>
                </VBox>

                <HBox spacing="10">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="City" styleClass="form-label"/>
                        <TextField fx:id="regCityField" promptText="e.g. Khulna"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Phone" styleClass="form-label"/>
                        <TextField fx:id="regPhoneField" promptText="Phone number"/>
                    </VBox>
                </HBox>

                <VBox spacing="4">
                    <Label text="Address" styleClass="form-label"/>
                    <TextField fx:id="regAddressField" promptText="Location details"/>
                </VBox>

                <Button text="Complete Registration" onAction="#handleRegister" maxWidth="Infinity" styleClass="success-button"/>
                <Label fx:id="regStatusLabel" styleClass="error-label"/>
            </VBox>
        </Tab>
    </TabPane>
</VBox>